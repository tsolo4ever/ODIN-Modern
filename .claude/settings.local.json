{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python -m pip*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(dir*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(tail*)",
      "Bash(head*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(del /f*)",
      "Bash(format*)",
      "Bash(rd /s*)"
    ],
    "defaultMode": "acceptEdits"
  }
}